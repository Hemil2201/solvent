# Copy to .env and fill in with your Supabase dev project's values
# (Supabase dashboard: Settings -> Database for DATABASE_URL, Settings -> API for the rest)

# Direct Postgres connection string, e.g.:
# postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local JWT signing secret for this app's own session tokens (independent of
# Supabase Auth — see backend/app/core/security.py). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# 1 year — this app only ever runs on Hemil's and Heenal's own phones, so a
# long-lived session beats building refresh/re-auth flows for no real gain.
JWT_EXPIRE_MINUTES=525600

# Statement parsing / categorization / receipt scanning (Slice 4) — blank is
# fine; PDF/messy-CSV statements fail to parse and categorization falls back
# to manual selection until this is set. Paid, usage-based — console.anthropic.com.
ANTHROPIC_API_KEY=

# Bank/card linking via Plaid. Sandbox client_id/secret are free — create an
# app at dashboard.plaid.com, Sandbox keys are issued immediately (no
# approval wait, unlike Production). Leave PLAID_ENV=sandbox until this is
# ready to point at real accounts.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Encrypts Plaid access tokens at rest (app/services/token_encryption.py) —
# the one real secret this app stores in its own DB, so this key matters.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_ENCRYPTION_KEY=

ENV=dev
